# ==========================================
# AMOGH MINERALS — ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# 1. Email SMTP Configuration (For Contact & Inquiry Form)
# Put your email ID and App Password here:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
INQUIRY_RECIPIENT_EMAIL=your_inquiry_recipient@example.com

# 2. Wix CMS Headless Integration (Wix Data API v2)
# Generate from Wix Dashboard -> Settings -> API Keys (Grant "Wix Data" permission)
# Site ID can be copied from your Wix Dashboard URL or Settings -> General
WIX_API_KEY=your_wix_api_key_here
WIX_SITE_ID=your_wix_site_id_here
WIX_ACCOUNT_ID=
WIX_CLIENTS_COLLECTION_ID=Clients
WIX_INQUIRIES_COLLECTION_ID=Inquiries
